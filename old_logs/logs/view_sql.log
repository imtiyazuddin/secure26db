b'CREATE OR REPLACE VIEW customer_view AS SELECT * FROM customer WHERE c_custkey IN (SELECT c_custkey FROM rls_bypass_view_customer);'
b'CREATE OR REPLACE VIEW supplier_view AS SELECT * FROM supplier WHERE s_suppkey IN (SELECT s_suppkey FROM rls_bypass_view_supplier);'
b'CREATE OR REPLACE VIEW partsupp_view AS SELECT * FROM partsupp WHERE (ps_partkey, ps_suppkey) IN (SELECT ps_partkey, ps_suppkey FROM rls_bypass_view_partsupp);'
b'CREATE OR REPLACE VIEW lineitem_view AS SELECT * FROM lineitem WHERE (l_orderkey, l_linenumber) IN (SELECT l_orderkey, l_linenumber FROM rls_bypass_view_lineitem);'

 select
        l_returnflag,
        l_linestatus,
        sum(l_quantity) as sum_qty,
        sum(l_extendedprice) as sum_base_price,
        sum(l_extendedprice * (1 - l_discount)) as sum_disc_price,
        sum(l_extendedprice * (1 - l_discount) * (1 + l_tax)) as sum_charge,
        avg(l_quantity) as avg_qty,
        avg(l_extendedprice) as avg_price,
        avg(l_discount) as avg_disc,
        count(*) as count_order
FROM lineitem_view
where
        l_shipdate <= date '1998-12-01' - interval '3' day
group by
        l_returnflag,
        l_linestatus
order by
        l_returnflag,
        l_linestatus
b"EXPLAIN select\n        l_returnflag,\n        l_linestatus,\n        sum(l_quantity) as sum_qty,\n        sum(l_extendedprice) as sum_base_price,\n        sum(l_extendedprice * (1 - l_discount)) as sum_disc_price,\n        sum(l_extendedprice * (1 - l_discount) * (1 + l_tax)) as sum_charge,\n        avg(l_quantity) as avg_qty,\n        avg(l_extendedprice) as avg_price,\n        avg(l_discount) as avg_disc,\n        count(*) as count_order\nFROM lineitem_view\nwhere\n        l_shipdate <= date '1998-12-01' - interval '3' day\ngroup by\n        l_returnflag,\n        l_linestatus\norder by\n        l_returnflag,\n        l_linestatus"

